<mxfile host="app.diagrams.net"><diagram id="rag" name="04-rag-chatbot"><mxGraphModel dx="1720" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n101" value="Nabd Assist: end-to-end RAG for retailer questions about policies, terms and orders (Session 4 mini project)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1500" height="25" as="geometry"/></mxCell><mxCell id="n102" value="Scenario: E-Commerce Policy &amp; Refund Assistant inside the Tawreed retailer app. Purple = a model call. Red = safeguard. Yellow tags = tunable values (config, not code)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1660" height="20" as="geometry"/></mxCell><mxCell id="n103" value="&lt;b&gt;Path A · Offline ingestion. Started by an admin or a distributor. Nobody waits for it.&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="68" width="1680" height="330" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;Admin / distributor&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;uploads or saves a form&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="150" height="56" as="geometry"/></mxCell><mxCell id="n105" value="&lt;b&gt;Sources&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="300" height="196" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Digital text: policies (Word, text PDF)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;text extraction library&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="212" width="276" height="40" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;Scanned PDF + OCR: distributor terms&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;form first; OCR fallback, distributor confirms&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="258" width="276" height="40" as="geometry"/></mxCell><mxCell id="n108" value="&lt;b&gt;Help-center articles: CMS rows we own&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="304" width="276" height="32" as="geometry"/></mxCell><mxCell id="n109" value="&lt;b&gt;Web crawler: not used (no outside site)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontSize=11;dashed=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="52" y="342" width="276" height="32" as="geometry"/></mxCell><mxCell id="n110" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n104" target="n105"><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="168" as="sourcePoint"/><mxPoint x="115" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n111" value="&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;in-country, S3-compatible&lt;br&gt;original + extracted text&lt;br&gt;doc_id, version, owner, audience&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="196" width="230" height="120" as="geometry"/></mxCell><mxCell id="n112" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n105" target="n111"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="256" as="sourcePoint"/><mxPoint x="400" y="256" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n113" value="&lt;b&gt;Chunking &amp;amp; metadata tagging&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;policies: by section&lt;br&gt;terms: per distributor x topic&lt;br&gt;articles: one per article&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="196" width="250" height="120" as="geometry"/></mxCell><mxCell id="n114" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n111" target="n113"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="256.0" as="sourcePoint"/><mxPoint x="690" y="256.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n115" value="&lt;b&gt;Embedding service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;multilingual model vX (pinned)&lt;br&gt;batch manager + CPU workers&lt;br&gt;model + version on every vector&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="196" width="240" height="120" as="geometry"/></mxCell><mxCell id="n116" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n113" target="n115"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="256.0" as="sourcePoint"/><mxPoint x="1000" y="256.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n117" value="&lt;b&gt;Vector DB: pgvector in Nabd Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;chunk text + vector + metadata&lt;br&gt;new version inserted, then the old one deleted&lt;br&gt;(ADR-0003; Qdrant if it outgrows Postgres)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="196" width="380" height="120" as="geometry"/></mxCell><mxCell id="n118" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n115" target="n117"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="256.0" as="sourcePoint"/><mxPoint x="1300" y="256.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n119" value="&lt;b&gt;chunk 400 tokens · overlap 50&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="250" height="28" as="geometry"/></mxCell><mxCell id="n120" value="&lt;b&gt;1 worker daily · 4 for a full re-index&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="240" height="28" as="geometry"/></mxCell><mxCell id="n121" value="No model until the embedding step." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="240" height="19" as="geometry"/></mxCell><mxCell id="n122" value="&lt;b&gt;Path B · Online inference. A retailer is waiting: p95 under 6 s for a document answer.&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="418" width="1680" height="572" as="geometry"/></mxCell><mxCell id="n123" value="&lt;b&gt;Retailer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Tawreed app&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="36" y="480" width="130" height="96" as="geometry"/></mxCell><mxCell id="n124" value="&lt;b&gt;Backend service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;API gateway + Tawreed&lt;br&gt;backend; retailer id&lt;br&gt;from the JWT&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="196" y="480" width="160" height="96" as="geometry"/></mxCell><mxCell id="n125" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n123" target="n124"><mxGeometry relative="1" as="geometry"><mxPoint x="166" y="528.0" as="sourcePoint"/><mxPoint x="196" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n126" value="&lt;b&gt;RAG service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;query parsing +&lt;br&gt;intent gate&lt;br&gt;(small classifier)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="386" y="480" width="170" height="96" as="geometry"/></mxCell><mxCell id="n127" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n124" target="n126"><mxGeometry relative="1" as="geometry"><mxPoint x="356" y="528.0" as="sourcePoint"/><mxPoint x="386" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n128" value="&lt;b&gt;Input safeguard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;PII, injection,&lt;br&gt;tool-abuse rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="586" y="480" width="150" height="96" as="geometry"/></mxCell><mxCell id="n129" value="document Q" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n126" target="n128"><mxGeometry relative="1" as="geometry"><mxPoint x="556" y="528.0" as="sourcePoint"/><mxPoint x="586" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n130" value="&lt;b&gt;Query embedding&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;same model vX&lt;br&gt;as Path A&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="766" y="480" width="150" height="96" as="geometry"/></mxCell><mxCell id="n131" value="pass" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n128" target="n130"><mxGeometry relative="1" as="geometry"><mxPoint x="736" y="528.0" as="sourcePoint"/><mxPoint x="766" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n132" value="&lt;b&gt;Vector DB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;top-K 20, filtered to&lt;br&gt;this retailer audience&lt;br&gt;+ re-rank, keep 5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="946" y="480" width="190" height="96" as="geometry"/></mxCell><mxCell id="n133" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n130" target="n132"><mxGeometry relative="1" as="geometry"><mxPoint x="916" y="528.0" as="sourcePoint"/><mxPoint x="946" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n134" value="&lt;b&gt;LLM generation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;system-prompt guardrails:&lt;br&gt;answer from chunks only,&lt;br&gt;last 6 turns of history&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1166" y="480" width="170" height="96" as="geometry"/></mxCell><mxCell id="n135" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n132" target="n134"><mxGeometry relative="1" as="geometry"><mxPoint x="1136" y="528.0" as="sourcePoint"/><mxPoint x="1166" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n136" value="&lt;b&gt;Output safeguard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;PDPL, tone, numbers&lt;br&gt;must match a source&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1366" y="480" width="150" height="96" as="geometry"/></mxCell><mxCell id="n137" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n134" target="n136"><mxGeometry relative="1" as="geometry"><mxPoint x="1336" y="528.0" as="sourcePoint"/><mxPoint x="1366" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n138" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;answer + sources,&lt;br&gt;not streamed:&lt;br&gt;scanned first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1546" y="480" width="140" height="96" as="geometry"/></mxCell><mxCell id="n139" value="pass" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n136" target="n138"><mxGeometry relative="1" as="geometry"><mxPoint x="1516" y="528.0" as="sourcePoint"/><mxPoint x="1546" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n140" value="reply through backend and channel" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#2d7d46;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n138" target="n123"><mxGeometry relative="1" as="geometry"><mxPoint x="1616.0" y="576" as="sourcePoint"/><mxPoint x="101.0" y="576" as="targetPoint"/><Array as="points"><mxPoint x="1616" y="900"/><mxPoint x="101" y="900"/></Array></mxGeometry></mxCell><mxCell id="n141" value="same index" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n117" target="n132"><mxGeometry relative="1" as="geometry"><mxPoint x="1340.0" y="316" as="sourcePoint"/><mxPoint x="1041.0" y="480" as="targetPoint"/><Array as="points"><mxPoint x="1340" y="440"/><mxPoint x="1041" y="440"/></Array></mxGeometry></mxCell><mxCell id="n142" value="&lt;b&gt;Fixed reply&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;small talk, off-topic&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="386" y="640" width="170" height="54" as="geometry"/></mxCell><mxCell id="n143" value="small talk" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#2d7d46;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n126" target="n142"><mxGeometry relative="1" as="geometry"><mxPoint x="466.0" y="576" as="sourcePoint"/><mxPoint x="466" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n144" value="&lt;b&gt;Read-only lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;orders, prices, stock&lt;br&gt;retailer id from token&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="386" y="716" width="170" height="64" as="geometry"/></mxCell><mxCell id="n145" value="order / price" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n126" target="n144"><mxGeometry relative="1" as="geometry"><mxPoint x="531.0" y="576" as="sourcePoint"/><mxPoint x="556" y="748" as="targetPoint"/><Array as="points"><mxPoint x="531" y="612"/><mxPoint x="571" y="612"/><mxPoint x="571" y="748"/></Array></mxGeometry></mxCell><mxCell id="n146" value="&lt;b&gt;Human handoff&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;complaint, legal,&lt;br&gt;payment dispute&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="196" y="716" width="160" height="64" as="geometry"/></mxCell><mxCell id="n147" value="complaint" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n126" target="n146"><mxGeometry relative="1" as="geometry"><mxPoint x="406.0" y="576" as="sourcePoint"/><mxPoint x="276.0" y="716" as="targetPoint"/><Array as="points"><mxPoint x="406" y="618"/><mxPoint x="276" y="618"/></Array></mxGeometry></mxCell><mxCell id="n148" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;below threshold: say I don&amp;#x27;t know,&lt;br&gt;link best article, offer support&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="946" y="640" width="190" height="64" as="geometry"/></mxCell><mxCell id="n149" value="below threshold" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#2d7d46;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n132" target="n148"><mxGeometry relative="1" as="geometry"><mxPoint x="1041.0" y="576" as="sourcePoint"/><mxPoint x="1041.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n150" value="&lt;b&gt;Blocked&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;fixed reply, logged&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="586" y="640" width="150" height="54" as="geometry"/></mxCell><mxCell id="n151" value="fail" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n128" target="n150"><mxGeometry relative="1" as="geometry"><mxPoint x="661.0" y="576" as="sourcePoint"/><mxPoint x="661.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n152" value="fail" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n136" target="n150"><mxGeometry relative="1" as="geometry"><mxPoint x="1441.0" y="576" as="sourcePoint"/><mxPoint x="722" y="694" as="targetPoint"/><Array as="points"><mxPoint x="1441" y="820"/><mxPoint x="722" y="820"/></Array></mxGeometry></mxCell><mxCell id="n153" value="&lt;b&gt;K = 20 · keep 5 · threshold from evals&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="946" y="720" width="190" height="26" as="geometry"/></mxCell><mxCell id="n154" value="&lt;b&gt;timeout 2 s = block&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="586" y="710" width="122" height="26" as="geometry"/></mxCell><mxCell id="n155" value="&lt;b&gt;answer up to ~120 words&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1166" y="640" width="170" height="26" as="geometry"/></mxCell><mxCell id="n156" value="&lt;b&gt;no write tools in v1&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="386" y="790" width="170" height="26" as="geometry"/></mxCell><mxCell id="n157" value="Latency budget (p95): routing 100 ms · intent 300 · input guard 400 · embed + search 150 · re-rank 250 · generate 3,500 · output guard 600 = about 5.3 s of 6 s. Small talk and lookups answer in under 1 s." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="36" y="930" width="1640" height="20" as="geometry"/></mxCell><mxCell id="n158" value="Decisions: ADR-0006 (RAG over fine-tuning), ADR-0005 (two-way guard), ADR-0003 (pgvector). Design detail: docs/04-rag-chatbot.md. Notes: docs/04-rag-mini-project.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="36" y="954" width="1640" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>