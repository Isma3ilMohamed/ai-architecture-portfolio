illed (≈1 s)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="566" as="sourcePoint"/><mxPoint x="1507" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="12 · &quot;Welcome to Tawreed: 3 offers from distributors that deliver to you&quot;" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1510" y="599" as="sourcePoint"/><mxPoint x="97" y="599" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e29" value="13 · taps the push" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="94" y="632" as="sourcePoint"/><mxPoint x="209" y="632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value="14 · GET /offers/{id} (60 ms)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212" y="665" as="sourcePoint"/><mxPoint x="327" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e31" value="15 · read offer (40 ms)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="698" as="sourcePoint"/><mxPoint x="445" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e32" value="16 · offer screen (render 40 ms)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="448" y="731" as="sourcePoint"/><mxPoint x="215" y="731" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="B1 · sink: retailers, orders, offers, consent" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#c96a00;fontColor=#c96a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="684" y="838" as="sourcePoint"/><mxPoint x="1271" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="B2 · nightly: segment defaults per shop type × governorate" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#c96a00;fontColor=#c96a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1156" y="874" as="sourcePoint"/><mxPoint x="1271" y="874" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="B3 · nightly: move retailers with 4 weeks of orders to personal ranking" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#c96a00;fontColor=#c96a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1156" y="910" as="sourcePoint"/><mxPoint x="1271" y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e36" value="B4 · weekly: welcome push uplift vs holdout (P4)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#c96a00;fontColor=#c96a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1156" y="946" as="sourcePoint"/><mxPoint x="1271" y="946" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend" value="Green arrows = real-time path · orange arrows = background ingestion and batch path · dashed = response · (ms) = latency budget per hop · grey lanes are in the high-level view but this flow does not need them. Nabd uses push (FCM) where the course architecture uses WhatsApp." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="996" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>