ry x="1102" y="112" width="108" height="60" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1156" y="172" as="sourcePoint"/><mxPoint x="1156" y="982" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane_cdp" value="&lt;b&gt;CDP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nabd store (Postgres)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="112" width="108" height="60" as="geometry"/></mxCell><mxCell id="e14" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1274" y="172" as="sourcePoint"/><mxPoint x="1274" y="982" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane_reco" value="&lt;b&gt;Recommendation&lt;br&gt;engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nabd rules + ranking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1338" y="112" width="108" height="60" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="172" as="sourcePoint"/><mxPoint x="1392" y="982" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane_push" value="&lt;b&gt;Push (FCM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Vendor] for WhatsApp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1456" y="112" width="108" height="60" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1510" y="172" as="sourcePoint"/><mxPoint x="1510" y="982" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="1 · signs up: kiosk, Gharbia, allows push" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="94" y="236" as="sourcePoint"/><mxPoint x="209" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="2 · POST /signup" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212" y="269" as="sourcePoint"/><mxPoint x="327" y="269" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="3 · create retailer + consent" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="302" as="sourcePoint"/><mxPoint x="445" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="4 · WAL change" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="448" y="335" as="sourcePoint"/><mxPoint x="563" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="5 · retailer_created" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#0f7b6c;fontColor=#0f7b6c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="368" as="sourcePoint"/><mxPoint x="681" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e