<mxfile host="app.diagrams.net"><diagram id="coldstart" name="Cold start flow (dynamic view)"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Nabd · Use-case flow view: cold start (a retailer&#x27;s first day)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28" y="14" width="1100" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="A kiosk owner in Gharbia signs up today. No orders, no features, no vector. Within a minute they get one welcome push with 3 offers from distributors that deliver to them." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="28" y="50" width="1400" height="40" as="geometry"/></mxCell><mxCell id="bandA" value="A · REAL-TIME PATH: sign-up → welcome push → retailer opens the offer" style="rounded=1;arcSize=1;html=1;fillColor=#eef7f4;strokeColor=#0f7b6c;dashed=1;fontSize=12;fontStyle=1;fontColor=#0f7b6c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="28" y="188" width="1556" height="572" as="geometry"/></mxCell><mxCell id="bandB" value="B · BACKGROUND INGESTION AND BATCH PATH: keeps the segment defaults fresh" style="rounded=1;arcSize=1;html=1;fillColor=#fff6eb;strokeColor=#c96a00;dashed=1;fontSize=12;fontStyle=1;fontColor=#c96a00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="28" y="790" width="1556" height="184" as="geometry"/></mxCell><mxCell id="lane_ret" value="&lt;b&gt;Retailer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person] new kiosk&lt;/font&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="108" height="60" as="geometry"/></mxCell><mxCell id="e1" va